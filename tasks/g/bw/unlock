#!/usr/bin/env bash
#MISE description="[global] bwu · Unlocks Bitwarden and shares the session (file in RAM + export for eval)"
#MISE alias="bwu"
set -euo pipefail

session_file="${XDG_RUNTIME_DIR:-/tmp}/bw-session"

# Reuse a session that is still valid
if [[ -r "$session_file" ]]; then
  session="$(<"$session_file")"
  [[ "$(BW_SESSION="$session" bw status | jq -r .status)" == "unlocked" ]] || session=""
fi

if [[ -z "${session:-}" ]]; then
  if [[ "$(bw status | jq -r .status)" == "unauthenticated" ]]; then
    echo "Bitwarden: not logged in. Run first: bw login" >&2
    exit 1
  fi
  session="$(bw unlock --raw < /dev/tty)"
  (umask 077 && printf '%s' "$session" > "$session_file")
fi

if [[ -t 1 ]]; then
  echo "Bitwarden unlocked (session in $session_file)." >&2
  echo "To export it in this shell: eval \"\$(mise run -q g:bw:unlock)\"" >&2
else
  printf 'export BW_SESSION=%q\n' "$session"
fi

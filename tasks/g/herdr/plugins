#!/usr/bin/env bash
#MISE description="[global] Installs the missing herdr plugins (Terminal Browser, Terminal Code)"
set -euo pipefail

# Wanted herdr plugins: "plugin id|GitHub source".
# Installing them also runs the program's official installer (into ~/.local).
# No effect on an already installed plugin: updates go through `mise run up`.
PLUGINS='
zenbu-labs.terminal-browser|zenbu-labs/terminal-browser/herdr-plugin
zenbu-labs.tode|zenbu-labs/terminal-code/herdr-plugin
'

installed="$(herdr plugin list 2>/dev/null || true)"
while IFS='|' read -r id source; do
  [[ -n "$id" ]] || continue
  if grep -qF -- "- $id " <<<"$installed"; then
    echo "already installed: $id"
  else
    echo "installing: $id ($source)"
    herdr plugin install -y "$source"
  fi
done <<<"$PLUGINS"

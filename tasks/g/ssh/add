#!/usr/bin/env bash
#MISE description="[global] sa · Adds or edits a server in Bitwarden (interactive questions)"
#MISE alias="sa"
#USAGE arg "[server]" help="Server alias (asked if missing)"
#USAGE complete "server" run="awk '/^Host /{print $2}' ~/.ssh/config.d/bitwarden-hosts"
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

ask() { local __v; read -rp "$1${2:+ [$2]}: " __v; printf '%s' "${__v:-${2:-}}"; }

bw_ensure_unlocked

alias="${usage_server:-}"
[[ -n "$alias" ]] || alias="$(ask "Alias (e.g. prod-api)")"
[[ "$alias" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Invalid alias: letters, digits, . _ - only." >&2; exit 1; }

# Default values: those of the existing item, if any
cur="{}"
raw="$(bw_ssh_raw_item "$alias")"
if [[ -n "$raw" ]]; then
  cur="$(jq "$SSH_ITEM_JQ" <<<"$raw")"
  echo "Existing item: Enter keeps the current value."
fi
def() { jq -r ".$1 // empty" <<<"$cur"; }

host="$(ask "IP address or hostname" "$(def host)")"
[[ -n "$host" ]] || { echo "Address required." >&2; exit 1; }
port="$(ask "Port" "$(def port || true)")"; port="${port:-22}"
scheme="$(ask "Type (ssh/sftp)" "$(def scheme || true)")"; scheme="${scheme:-ssh}"
user="$(ask "User (empty = $USER)" "$(def user)")"
read -rsp "Password (empty = ${raw:+unchanged / }SSH key): " SSH_PASSWORD; echo
export SSH_PASSWORD
identity="$(ask "Private key (empty = none)" "$(def identity)")"

echo "Commands on connect, one per line, empty line to finish:"
[[ -n "$(def commands)" ]] && { echo "(current:)"; def commands | sed 's/^/    /'; echo "(leave empty to keep them)"; }
commands=""
while IFS= read -r line && [[ -n "$line" ]]; do commands+="$line"$'\n'; done
commands="${commands%$'\n'}"
[[ -n "$commands" ]] || commands="$(def commands)"

printf "Testing negotiation with %s:%s… " "$host" "$port"
if ssh_needs_legacy_rsa "$host" "$port"; then legacy=true; echo "old server (ssh-rsa enabled)"; else legacy=false; echo "ok"; fi

bw_ssh_upsert "$alias" "$scheme://$host:$port" "$user" "$commands" "$legacy" "$identity"
unset SSH_PASSWORD
"$(dirname "$0")/sync"
echo "Connect: mise run sc $alias"

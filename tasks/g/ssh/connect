#!/usr/bin/env bash
#MISE description="[global] SSH/SFTP connection to a server described in Bitwarden (item ssh/<alias>)"
#MISE alias="sc"
#USAGE arg "<server>" help="Server alias (Bitwarden item ssh/<alias>)"
#USAGE flag "--no-shell" help="Run the item commands, then exit"
#USAGE flag "--sftp" help="Open an SFTP session instead of a shell"
#USAGE complete "server" run="awk '/^Host /{print $2}' ~/.ssh/config.d/bitwarden-hosts"
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

bw_ensure_unlocked
raw="$(bw_ssh_raw_item "$usage_server")"
[[ -n "$raw" ]] || { echo "No Bitwarden item \"$SSH_PREFIX$usage_server\". See: mise run g:ssh:list" >&2; exit 1; }
item="$(jq "$SSH_ITEM_JQ" <<<"$raw")"
get() { jq -r ".$1" <<<"$item"; }

scheme="$(get scheme)"; host="$(get host)"; port="$(get port)"; user="$(get user)"
commands="$(get commands)"; identity="$(get identity)"
[[ -n "$host" ]] || { echo "The item has no valid ssh://host:port URI." >&2; exit 1; }

opts=(-o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30)
[[ "$(get legacy)" == "true" ]] && opts+=(-o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa)
[[ -n "$identity" ]] && opts+=(-i "${identity/#\~/$HOME}")
target="${user:+$user@}$host"

prefix=()
SSHPASS="$(get password)"
if [[ -n "$SSHPASS" ]]; then
  export SSHPASS
  prefix=(sshpass -e)
  opts+=(-o PreferredAuthentications=password,keyboard-interactive)
else
  unset SSHPASS
fi

if [[ "$scheme" == "sftp" || "${usage_sftp:-false}" == "true" ]]; then
  exec "${prefix[@]}" sftp -P "$port" "${opts[@]}" "$target"
elif [[ -n "$commands" && "${usage_no_shell:-false}" == "true" ]]; then
  exec "${prefix[@]}" ssh -p "$port" "${opts[@]}" "$target" 'bash -s' <<<"$commands"
elif [[ -n "$commands" ]]; then
  exec "${prefix[@]}" ssh -t -p "$port" "${opts[@]}" "$target" "$commands"$'\n''exec $SHELL -l'
else
  exec "${prefix[@]}" ssh -p "$port" "${opts[@]}" "$target"
fi

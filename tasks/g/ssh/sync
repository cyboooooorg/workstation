#!/usr/bin/env bash
#MISE description="[global] ss · Regenerates ~/.ssh/config.d/bitwarden-hosts from Bitwarden (for ssh, scp, VS Code and completion)"
#MISE alias="ss"
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

bw_ensure_unlocked
mkdir -p "$(dirname "$SSH_GENERATED_CONFIG")"
tmp="$(mktemp)"
{
  echo "# Generated by \"mise run g:ssh:sync\" from Bitwarden ($(date '+%F %T')). Do not edit: edit the ssh/* items in Bitwarden."
  bw_ssh_items | jq -r '.[] | select(.host != "") |
    "\nHost \(.alias)",
    "    HostName \(.host)",
    "    Port \(.port)",
    (if .user != "" then "    User \(.user)" else empty end),
    (if .identity != "" then "    IdentityFile \(.identity)" else empty end),
    (if .legacy then "    HostKeyAlgorithms +ssh-rsa\n    PubkeyAcceptedAlgorithms +ssh-rsa" else empty end),
    "    StrictHostKeyChecking accept-new",
    "    ServerAliveInterval 30"'
} > "$tmp"
install -m 600 "$tmp" "$SSH_GENERATED_CONFIG" && rm -f "$tmp"
echo "$(grep -c '^Host ' "$SSH_GENERATED_CONFIG") server(s) written to $SSH_GENERATED_CONFIG"
bw_ssh_items | jq -r '.[] | select(.host == "") | "Skipped (no ssh://host:port URI): \(.alias) -> mise run sa \(.alias)"' >&2

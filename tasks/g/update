#!/usr/bin/env bash
#MISE description="[global] Met à jour tout le système : dépôt workstation, mise, outils mise, plugins herdr, Homebrew, apt et snap"
#MISE alias=["up", "up-all"]
set -euo pipefail

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*" >&2; }

BREW="$(command -v brew || true)"

# ─── Section dépôt workstation ────────────────────────────────────
# ~/.config/mise est un lien vers le dépôt : on récupère la dernière config,
# puis bootstrap applique ce qui manque (outils, paquets, dotfiles…).
step "Dépôt workstation"
config_dir="$(cd ~/.config/mise && pwd -P)"
if git -C "$config_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$config_dir" pull --ff-only || warn "git pull a échoué (modifications locales ?)"
  mise bootstrap --yes || warn "mise bootstrap a échoué"
fi

# ─── Section mise lui-même ────────────────────────────────────────
# Installé par Homebrew (brew upgrade, plus bas) ou par mise.run (self-update).
step "mise"
mise self-update --yes 2>/dev/null || echo "mise est géré par Homebrew : mis à jour avec brew"

# ─── Section outils mise ──────────────────────────────────────────
# Outils globaux de ~/.config/mise/config.toml (claude, herdr, node, docker-cli…),
# puis suppression des versions qui ne sont plus utilisées.
step "Outils mise"
mise upgrade
mise prune --yes

# ─── Section plugins herdr ────────────────────────────────────────
# « herdr plugin update » ne met à jour que les plugins eux-mêmes (dépôts GitHub).
# Les programmes qu'ils lancent sortent à leur propre rythme et ont leur propre
# commande de mise à jour (installés dans ~/.local, hors mise).
# Un échec ici n'interrompt pas la suite (Homebrew, apt, snap).
step "Plugins herdr"
herdr plugin update -y || warn "herdr plugin update a échoué"

step "terminal-browser (plugin herdr Terminal Browser)"
if command -v terminal-browser >/dev/null; then
  terminal-browser upgrade || warn "terminal-browser upgrade a échoué"
fi

step "tode (plugin herdr Terminal Code)"
if command -v tode >/dev/null; then
  tode --upgrade || warn "tode --upgrade a échoué"
fi

# ─── Section Homebrew (macOS : colima, kitty… ; Linux : mise lui-même) ──
if [[ -n "$BREW" ]]; then
  step "Homebrew"
  "$BREW" update --quiet
  "$BREW" upgrade
fi

# ─── Section apt (paquets système, sudo) ──────────────────────────
if command -v apt-get >/dev/null; then
  step "apt"
  sudo apt-get update
  sudo apt-get upgrade -y
  sudo apt-get autoremove -y
fi

# ─── Section snap (Discord, Mockoon…) ─────────────────────────────
if command -v snap >/dev/null; then
  step "snap"
  sudo snap refresh
fi

# ─── Section nettoyage ────────────────────────────────────────────
# Caches Homebrew, mise et apt, et anciennes révisions snap désactivées.
step "Nettoyage"
[[ -n "$BREW" ]] && "$BREW" cleanup --prune=all --quiet
mise cache clear
if command -v apt-get >/dev/null; then sudo apt-get clean; fi
if command -v snap >/dev/null; then
  snap list --all | awk '/disabled/ {print $1, $3}' | while read -r name rev; do
    sudo snap remove "$name" --revision="$rev"
  done
fi

step "Terminé"

#!/usr/bin/env bash
#MISE description="[global] up, up-all · Updates the whole system: workstation repository, mise, mise tools, herdr plugins, Homebrew, apt and snap"
#MISE alias=["up", "up-all"]
set -euo pipefail

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*" >&2; }

BREW="$(command -v brew || true)"

# ─── Workstation repository ───────────────────────────────────────
# ~/.config/mise links to the repository: fetch the latest config,
# then bootstrap applies whatever is missing (tools, packages, dotfiles…).
step "Workstation repository"
config_dir="$(cd ~/.config/mise && pwd -P)"
if git -C "$config_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$config_dir" pull --ff-only || warn "git pull failed (local changes?)"
  mise bootstrap --yes || warn "mise bootstrap failed"
fi

# ─── mise itself ──────────────────────────────────────────────────
# Installed by Homebrew (brew upgrade, below) or by mise.run (self-update).
step "mise"
mise self-update --yes 2>/dev/null || echo "mise is managed by Homebrew: updated with brew"

# ─── mise tools ───────────────────────────────────────────────────
# Global tools from ~/.config/mise/config.toml (claude, herdr, node, docker-cli…),
# then removal of the versions no longer used.
step "mise tools"
mise upgrade
mise prune --yes

# ─── herdr plugins ────────────────────────────────────────────────
# `herdr plugin update` only updates the plugins themselves (GitHub repositories).
# The programs they run are released at their own pace and have their own
# update command (installed into ~/.local, outside mise).
# A failure here does not stop the rest (Homebrew, apt, snap).
step "herdr plugins"
herdr plugin update -y || warn "herdr plugin update failed"

step "terminal-browser (herdr plugin Terminal Browser)"
if command -v terminal-browser >/dev/null; then
  terminal-browser upgrade || warn "terminal-browser upgrade failed"
fi

step "tode (herdr plugin Terminal Code)"
if command -v tode >/dev/null; then
  tode --upgrade || warn "tode --upgrade failed"
fi

# ─── Homebrew (macOS: colima, kitty…; Linux: mise itself) ─────────
if [[ -n "$BREW" ]]; then
  step "Homebrew"
  "$BREW" update --quiet
  "$BREW" upgrade
fi

# ─── apt (system packages, sudo) ──────────────────────────────────
if command -v apt-get >/dev/null; then
  step "apt"
  sudo apt-get update
  sudo apt-get upgrade -y
  sudo apt-get autoremove -y
fi

# ─── snap (Discord, Mockoon…) ─────────────────────────────────────
if command -v snap >/dev/null; then
  step "snap"
  sudo snap refresh
fi

# ─── Cleanup ──────────────────────────────────────────────────────
# Homebrew, mise and apt caches, and old disabled snap revisions.
step "Cleanup"
[[ -n "$BREW" ]] && "$BREW" cleanup --prune=all --quiet
mise cache clear
if command -v apt-get >/dev/null; then sudo apt-get clean; fi
if command -v snap >/dev/null; then
  snap list --all | awk '/disabled/ {print $1, $3}' | while read -r name rev; do
    sudo snap remove "$name" --revision="$rev"
  done
fi

step "Done"
